# ═══════════════════════════════════════════════════════════════
# HUNTER PRO INTELLIGENCE — CONFIGURACIÓN DE ENTORNO
# ═══════════════════════════════════════════════════════════════
# ⚠️ COPIA ESTE ARCHIVO A .env Y COMPLETA LOS VALORES.
# NUNCA SUBAS .env A GIT (PROTEGIDO POR .gitignore).

# 🔐 Criptografía y Sesiones
LEADS_ENCRYPTION_KEY=tu_clave_hex_de_32_bytes_aqui
JWT_SECRET=tu_clave_secreta_jwt_para_sesiones

# 💳 Pasarela Wompi Colombia (Modo Sandbox o Producción)
# WOMPI_ENV: "sandbox" para usar credenciales test_*, "produccion" para llaves reales.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_Q5yDA9xoKdePzhSGeVe9KStXTIIOxjwW
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_secret_aqui
WOMPI_EVENTS_SECRET=test_events_secret_aqui

# 🔥 Firebase Firestore Ledger (Opcional en Sandbox, requerido en Producción)
# Si no están configuradas, el sistema usa un almacenamiento local seguro en memoria/disco.
FIREBASE_PROJECT_ID=hunter-pro-intelligence
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ✉️ Notificaciones y Recuperación de PIN vía Email (Resend API)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL="Origgo <seguridad@origgo.co>"
APP_URL=https://origgo.co
