# ═══════════════════════════════════════════════════════════════
# ORIGGO SHOWCASE — CONFIGURACIÓN DE ENTORNO SERVERLESS
# ═══════════════════════════════════════════════════════════════
# ⚠️ COPIA ESTE ARCHIVO A .env Y COMPLETA LOS VALORES.
# NUNCA SUBAS .env A GIT (PROTEGIDO POR .gitignore).

# 🔐 Criptografía y Sesiones
LEADS_ENCRYPTION_KEY=cf5e87913d4cf975ab463ada86e9ce905b9d5306c5188af3f8a074159cbf9a2c
# Versionado y rotación criptográfica AES-256 (kid: 'v1', 'v2', etc.)
LEADS_KEY_VERSION=v1
# Claves rotadas opcionales para descifrado cruzado mediante Keyring:
# LEADS_ENCRYPTION_KEY_V2=
# LEADS_KEYRING_JSON={"v1":"cf5e8791...","v2":"8d9e7f..."}
JWT_SECRET=tu_clave_secreta_jwt_para_sesiones_minimo_32_caracteres

# 🛡️ Protección Anti-Fuerza Bruta (Cloudflare Turnstile Opcional / $0 Costo)
# Si no se configuran, el sistema usa automáticamente Proof-of-Work criptográfico local (sin dependencias).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# 🛡️ Rate Limiting Distribuido en Vercel Serverless (Upstash Redis REST - $0 Free Tier)
# Crea tu base de datos gratuita en https://console.upstash.com (Región us-east-1)
UPSTASH_REDIS_REST_URL=https://tu-base.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXXXAAIncDF...==

# 💳 Pasarela Wompi Colombia (Modo Sandbox o Producción)
# WOMPI_ENV: "sandbox" para usar credenciales test_*, "produccion" para llaves reales.
WOMPI_ENV=sandbox
WOMPI_PUBLIC_KEY=pub_test_Q5yDA9xoKdePzhSGeVe9KStXTIIOxjwW
WOMPI_PRIVATE_KEY=prv_test_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
WOMPI_INTEGRITY_SECRET=test_integrity_secret_aqui
WOMPI_EVENTS_SECRET=test_events_secret_aqui

# 🔔 Web Push Notifications PWA ($0 Costo - Sin WhatsApp API)
# Generadas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@origgo.online

# 🔥 Firebase Firestore Ledger (Opcional en Sandbox, requerido en Producción)
# Si no están configuradas, el sistema usa un almacenamiento local seguro en memoria/disco.
FIREBASE_PROJECT_ID=hunter-pro-intelligence
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ✉️ Notificaciones y Recuperación de PIN vía Email (Resend API)
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXX
RESEND_FROM_EMAIL="Origgo <seguridad@origgo.online>"
APP_URL=https://origgo.online

# 🤖 AI Studio / Gemini API
GEMINI_API_KEY=

# 📱 Ingesta Segura de Leads desde Hardware (Samsung Galaxy J7 / Scraper Local)
# Token secreto para autenticar peticiones POST /api/leads/ingest vía cabecera x-origgo-ingest-token
INGEST_SECRET_KEY=tu_token_secreto_de_ingesta_minimo_32_caracteres

