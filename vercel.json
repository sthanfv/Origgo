{
  "buildCommand": "node scripts/build.js",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/payments/reconcile-cron",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/telemetry/cron",
      "schedule": "0 1 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.origgo.online"
        }
      ],
      "destination": "https://origgo.online/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/auth/:action",
      "destination": "/api/auth?action=:action"
    },
    {
      "source": "/api/notifications/vapid-public-key",
      "destination": "/api/notifications?action=vapid-public-key"
    },
    {
      "source": "/api/notifications/:action",
      "destination": "/api/notifications?action=:action"
    },
    {
      "source": "/api/payments/verify",
      "destination": "/api/payments/create-order"
    },
    {
      "source": "/api/payments/webhook",
      "destination": "/api/payments/webhook-wompi"
    },
    {
      "source": "/api/support/:action",
      "destination": "/api/support?action=:action"
    },
    {
      "source": "/api/telemetry/:action",
      "destination": "/api/telemetry?action=:action"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://checkout.wompi.co https://*.wompi.co https://ka-f.fontawesome.com; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' data: https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src 'self' https://checkout.wompi.co https://*.wompi.co; connect-src 'self' https://checkout.wompi.co https://*.wompi.co https://pub-040118b18ae247d7b4643d22289744b6.r2.dev https://*.r2.dev; object-src 'none'; base-uri 'self';"
        }
      ]
    },
    {
      "source": "/data/(.*).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=600"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/(.*).(css|js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}

